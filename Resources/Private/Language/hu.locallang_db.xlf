      <trans-unit id="plugin.list.title">
        <source>List all events</source>
        <target state="translated">Összes esemény listázása</target>
      </trans-unit>
      <trans-unit id="plugin.list.description">
        <source>Displays a list of all events. You can reduce this list to appropriate categories and organizers.</source>
        <target state="translated">Az összes esemény listáját jeleníti meg. A listát szűkítheti a megfelelő kategóriákra és szervezőkre.</target>
      </trans-unit>
      <trans-unit id="plugin.listLatest.title">
        <source>List latest events</source>
        <target state="translated">Legújabb események listája</target>
      </trans-unit>
      <trans-unit id="plugin.listLatest.description">
        <source>Displays a list of latest events. You can reduce this list to appropriate categories and organizers.</source>
        <target state="translated">A legújabb események listáját jeleníti meg. A listát szűkítheti a megfelelő kategóriákra és szervezőkre.</target>
      </trans-unit>
      <trans-unit id="plugin.listToday.title">
        <source>List of today's events</source>
        <target state="translated">A mai események listája</target>
      </trans-unit>
      <trans-unit id="plugin.listToday.description">
        <source>Displays a list of today's events. You can reduce this list to appropriate categories and organizers.</source>
        <target state="translated">A mai események listáját jeleníti meg. A listát szűkítheti a megfelelő kategóriákra és szervezőkre.</target>
      </trans-unit>
      <trans-unit id="plugin.listWeek.title">
        <source>List of this week's events</source>
        <target state="translated">A heti események listája</target>
      </trans-unit>
      <trans-unit id="plugin.listWeek.description">
        <source>Displays a list of this week's events. You can reduce this list to appropriate categories and organizers.</source>
        <target state="translated">A heti események listáját jeleníti meg. A listát szűkítheti a megfelelő kategóriákra és szervezőkre.</target>
      </trans-unit>
      <trans-unit id="plugin.listRange.title">
        <source>List events in date range</source>
        <target state="translated">Események listázása dátumtartomány szerint</target>
      </trans-unit>
      <trans-unit id="plugin.listRange.description">
        <source>Displays a list of events in date range. You can reduce this list to appropriate categories and organizers.</source>
        <target state="translated">A dátumtartományba eső események listáját jeleníti meg. A listát szűkítheti a megfelelő kategóriákra és szervezőkre.</target>
      </trans-unit>
      <trans-unit id="plugin.show.title">
        <source>Show single event</source>
        <target state="translated">Egyetlen esemény megjelenítése</target>
      </trans-unit>
      <trans-unit id="plugin.show.description">
        <source>Use this plugin to display a single event or for the detailed view.</source>
        <target state="translated">Ezzel a beépülő modullal jeleníthet meg egyetlen eseményt vagy a részletes nézetet.</target>
      </trans-unit>
      <trans-unit id="plugin.management.title">
        <source>Manage events</source>
        <target state="translated">Események kezelése</target>
      </trans-unit>
      <trans-unit id="plugin.management.description">
        <source>Use this plugin to create, edit and view a user's events.</source>
        <target state="translated">Ezzel a beépülő modullal hozhat létre, szerkeszthet és tekinthet meg egy felhasználó eseményeit.</target>
      </trans-unit>
      <trans-unit id="plugin.calendar.title">
        <source>Show monthly calendar</source>
        <target state="translated">Havi naptár megjelenítése</target>
      </trans-unit>
      <trans-unit id="plugin.calendar.description">
        <source>Displays a monthly calendar highlighting days with events. By clicking, events of the selected day are displayed.</source>
        <target state="translated">Havi naptárat jelenít meg, kiemelve az eseményekkel rendelkező napokat. Kattintásra a kiválasztott nap eseményei jelennek meg.</target>
      </trans-unit>
      <trans-unit id="plugin.searchForm.title">
        <source>Search form</source>
        <target state="translated">Keresőűrlap</target>
      </trans-unit>
      <trans-unit id="plugin.searchForm.description">
        <source>Shows the search form for events. Here a visitor can filter the events according to several criteria.</source>
        <target state="translated">Az események keresőűrlapját jeleníti meg. Itt a látogató több szempont szerint szűrheti az eseményeket.</target>
